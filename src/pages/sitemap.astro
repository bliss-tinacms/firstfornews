---
import Base from '../layouts/Base.astro';
import { listBlogs, listPages } from '../lib/data';
import { getBlogPermalink, getPageRouteSlug } from '../lib/permalinks';

export const prerender = false;

const pages = await listPages();
const posts = await listBlogs();

const title = 'Sitemap | First For News';
const description = 'Browse the public pages and latest reporting published by First For News.';

function cleanTitle(value: unknown, fallback = 'Untitled') {
  return typeof value === 'string' && value.trim() ? value.trim() : fallback;
}

function withTrailingSlash(value: string) {
  if (!value || value === '/') return '/';
  const normalized = value.startsWith('/') ? value : '/' + value;
  return normalized.endsWith('/') ? normalized : normalized + '/';
}

function pageUrl(page: any) {
  const filename = page?._sys?.filename || '';
  if (filename === 'home') return '/';
  return withTrailingSlash(getPageRouteSlug(page) || filename);
}

function postUrl(post: any) {
  return withTrailingSlash(getBlogPermalink(post));
}

function isHiddenPage(page: any) {
  const filename = page?._sys?.filename || '';
  const url = pageUrl(page);
  return Boolean(
    page?.draft ||
    page?.seo?.noindex ||
    filename === '404' ||
    filename === 'sitemap' ||
    url === '/sitemap/'
  );
}

function isHiddenPost(post: any) {
  return Boolean(post?.draft || post?.seo?.noindex);
}

const pageLinks = pages
  .filter((page) => !isHiddenPage(page))
  .map((page) => ({
    title: cleanTitle(page.title || page.seoTitle || page.seo?.metaTitle, page?._sys?.filename || 'Page'),
    url: pageUrl(page),
  }))
  .sort((a, b) => {
    if (a.url === '/') return -1;
    if (b.url === '/') return 1;
    return a.title.localeCompare(b.title);
  });

const postLinks = posts
  .filter((post) => !isHiddenPost(post))
  .map((post) => ({
    title: cleanTitle(post.title || post.seo?.metaTitle, post?._sys?.filename || 'Story'),
    url: postUrl(post),
    date: post.pubDate ? new Date(post.pubDate) : null,
  }))
  .sort((a, b) => Number(b.date || 0) - Number(a.date || 0));

const totalLinks = pageLinks.length + postLinks.length;
const latestPost = postLinks[0] ?? null;
const updated = new Date();
---

<Base
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  canonicalUrl="/sitemap/"
>
  <main class="ffn-demo ffn-demo-sitemap" aria-labelledby="sitemap-title">
    <header class="ph sitemap-ph">
      <div class="w">
        <div class="ph-in sitemap-ph__in">
          <div class="ph-k"><b>Site index</b></div>
          <h1 id="sitemap-title">Sitemap</h1>
          <p class="ph-d">A clean index of First For News public pages and published reporting, pulled dynamically from the Tina content collections.</p>
          <div class="sitemap-metrics" aria-label="Sitemap totals">
            <span><strong>{pageLinks.length}</strong> Pages</span>
            <span><strong>{postLinks.length}</strong> Stories</span>
            <span><strong>{totalLinks}</strong> Total links</span>
          </div>
        </div>
      </div>
    </header>

    <section class="sc sitemap-intro">
      <div class="w sitemap-intro__grid">
        <div>
          <div class="eye"><i></i><span>Dynamic directory</span></div>
          <h2 class="h2">Pages and reporting from the live backend</h2>
        </div>
        <div class="sitemap-note">
          <p>This sitemap uses the same Tina-backed page and post loaders as the public website. When editors publish or hide pages and stories, this index follows the live content data.</p>
          <p class="sitemap-note__meta">Last checked by the page render: <time datetime={updated.toISOString()}>{updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>{latestPost ? ` · Latest story: ${latestPost.title}` : ''}</p>
        </div>
      </div>
    </section>

    <section class="sc alt sitemap-directory">
      <div class="w sitemap-grid">
        <section class="sitemap-panel" aria-labelledby="sitemap-pages-title">
          <div class="sitemap-panel__top">
            <span>Pages</span>
            <b>{pageLinks.length} links</b>
          </div>
          <div class="sitemap-panel__body">
            <div class="eye"><i></i><span>Public pages</span></div>
            <h2 id="sitemap-pages-title" class="h2">Website pages</h2>
            {pageLinks.length > 0 ? (
              <ul class="sitemap-list">
                {pageLinks.map((item, index) => (
                  <li>
                    <span class="sitemap-list__number">{String(index + 1).padStart(2, '0')}</span>
                    <a href={item.url}>{item.title}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="sitemap-empty">No public pages found.</p>
            )}
          </div>
        </section>

        <section class="sitemap-panel" aria-labelledby="sitemap-posts-title">
          <div class="sitemap-panel__top">
            <span>Stories</span>
            <b>{postLinks.length} links</b>
          </div>
          <div class="sitemap-panel__body">
            <div class="eye"><i></i><span>Published reporting</span></div>
            <h2 id="sitemap-posts-title" class="h2">Latest stories</h2>
            {postLinks.length > 0 ? (
              <ul class="sitemap-list sitemap-list--posts">
                {postLinks.map((item, index) => (
                  <li>
                    <span class="sitemap-list__number">{String(index + 1).padStart(2, '0')}</span>
                    <a href={item.url}>{item.title}</a>
                    {item.date && <time datetime={item.date.toISOString()}>{item.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="sitemap-empty">No published stories found.</p>
            )}
          </div>
        </section>
      </div>
    </section>
  </main>
</Base>
