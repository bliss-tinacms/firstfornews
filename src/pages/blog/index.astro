---
import { getBlogPermalink } from '../../lib/permalinks';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getConfig, listBlogs } from '../../lib/data';

export const prerender = false;

const posts = await listBlogs();
const config = (await getConfig()).data?.config ?? null;
const title = `Blog | ${config?.seo?.title ?? 'TinaCMS + Astro'}`;
const description = config?.seo?.description ?? 'Latest blog posts.';

function getReferenceLabel(reference: unknown) {
	if (!reference) return null;
	if (Array.isArray(reference)) {
		const labels = reference.map(getReferenceLabel).filter(Boolean);
		return labels.length ? labels.join(', ') : null;
	}
	if (typeof reference === 'string') {
		return reference.split('/').pop()?.replace(/\.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
	}
	if (typeof reference === 'object') {
		const item = reference as { title?: string; name?: string };
		return String(item.title ?? item.name ?? '') || null;
	}
	return null;
}
---

<Base
	title={title}
	description={description}
>
	<main class="mx-auto max-w-5xl px-6 py-12">
		<h1 class="mb-8 text-4xl font-semibold tracking-tight">Blog</h1>
		<ul class="grid list-none gap-6 p-0 sm:grid-cols-2">
			{posts.map((post) => (
				<li>
					<a href={getBlogPermalink(post) + '/'} class="group block overflow-hidden rounded-xl border bg-card shadow-sm transition-shadow hover:shadow-md">
						{post.heroImage && (
							<img width={720} height={360} src={post.heroImage} alt={post.title ?? ''} class="aspect-video w-full object-cover" />
						)}
						<div class="p-6">
							{getReferenceLabel(post.category) && (
								<p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-primary">
									{getReferenceLabel(post.category)}
								</p>
							)}
							<h2 class="font-semibold group-hover:underline">{post.title}</h2>
							{post.pubDate && (
								<p class="mt-1 text-sm text-muted-foreground">
									{getReferenceLabel(post.author) && <span>By {getReferenceLabel(post.author)} · </span>}
									<FormattedDate date={new Date(post.pubDate)} />
								</p>
							)}
						</div>
					</a>
				</li>
			))}
		</ul>
	</main>
</Base>
