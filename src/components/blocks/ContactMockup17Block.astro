---
const { data = {}, config = null } = Astro.props;
const hero = data.hero ?? {};
const formSection = data.formSection ?? {};
const inboxes = data.inboxes ?? {};
const requests = data.requests ?? {};
const inboxCards = Array.isArray(inboxes.cards) ? inboxes.cards : [];
const requestCards = Array.isArray(requests.cards) ? requests.cards : [];
async function getLiveGlobalFormspreeEndpoint() {
  const fallback = config?.contactForm?.formspreeEndpoint || '';
  const query = `query ContactFormEndpoint {
    config(relativePath: "config.json") {
      contactForm { formspreeEndpoint }
    }
  }`;

  const endpoints = [
    process.env.NEXT_PUBLIC_TINA_CONTENT_API_URL,
    process.env.TINA_PUBLIC_TINA_CONTENT_API_URL,
    process.env.PUBLIC_TINA_CONTENT_API_URL,
    'https://firstfornews.net/tina-content-proxy',
  ].filter(Boolean);

  for (const endpoint of endpoints) {
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ query }),
        cache: 'no-store',
      });
      if (!response.ok) continue;
      const json = await response.json();
      const value = json?.data?.config?.contactForm?.formspreeEndpoint;
      if (typeof value === 'string' && value.trim()) return value.trim();
    } catch (_error) {
      // keep fallback below
    }
  }

  return fallback;
}

const globalFormspreeEndpoint = await getLiveGlobalFormspreeEndpoint();
const formAction = globalFormspreeEndpoint || formSection.formAction || '';
const formMethod = formAction ? 'POST' : undefined;
const buttonText = (formSection.buttonText || 'Send message').replace(/\s*(â†’|Ã¢â€ â€™|Ã‚â€ â€™|ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢)\s*$/g, '');
---
<section class="contact-template">
  <header class="contact-ph"><div class="contact-w">
    <div class="contact-ph-kick"><i></i><span>{hero.eyebrow}</span></div>
    <h1>{hero.headline}</h1>
    <p class="contact-ph-lede">{hero.lede}</p>
  </div></header>

  <section class="contact-main"><div class="contact-w"><div class="contact-main-in">
    <div class="contact-fm">
      <div class="contact-fm-eye"><i></i><span>{formSection.eyebrow}</span></div>
      <h2>{formSection.title}</h2>
      <p class="contact-fm-x">{formSection.description}</p>
      <form action={formAction || undefined} method={formMethod} accept-charset="UTF-8">
        {formSection.subject && <input type="hidden" name="_subject" value={formSection.subject} />}
        <input type="text" name="_gotcha" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="contact-f3">
          <div class="contact-frow"><label class="contact-flab" for="contact-full-name">Full Name <b>*</b></label><input class="contact-finp" id="contact-full-name" name="full_name" type="text" placeholder="Your full name" autocomplete="name" required /></div>
          <div class="contact-frow"><label class="contact-flab" for="contact-email">Email <b>*</b></label><input class="contact-finp" id="contact-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required /></div>
          <div class="contact-frow"><label class="contact-flab" for="contact-phone">Phone</label><input class="contact-finp" id="contact-phone" name="phone" type="tel" placeholder="(000) 000-0000" autocomplete="tel" /></div>
        </div>
        <div class="contact-frow"><label class="contact-flab" for="contact-message">Message <b>*</b></label><textarea class="contact-finp" id="contact-message" name="message" placeholder="What happened, who is involved, and any documents you can share" required></textarea></div>
        <button class="contact-fbtn" type={formAction ? 'submit' : 'button'}>{buttonText}</button>
        <p class="contact-fnote">{formSection.note}</p>
      </form>
    </div>

    <aside class="contact-side">
      <div class="contact-side-eye">{inboxes.eyebrow}</div>
      <h2>{inboxes.title}</h2>
      {inboxCards.map((item) => (
        <div class="contact-ch">
          <div class="contact-ch-t">{item.title}</div>
          <p class="contact-ch-x">{item.description}</p>
          {item.email && <a href={'mailto:' + item.email} class="contact-ch-a">{item.email}</a>}
          <p class="contact-ch-note">{item.note}</p>
        </div>
      ))}
    </aside>
  </div></div></section>

  <section class="contact-nt"><div class="contact-w">
    <div class="contact-nt-h">
      <div class="contact-nt-eye"><i></i><span>{requests.eyebrow}</span><i></i></div>
      <h2>{requests.title}</h2>
      <p>{requests.intro}</p>
    </div>
    <div class="contact-nt-g">
      {requestCards.map((item) => (
        <article class="contact-nc">
          <div class="contact-nc-i" aria-hidden="true">
            {item.icon === 'document' ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            ) : item.icon === 'mail' ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6 12 13 2 6"/></svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            )}
          </div>
          <div class="contact-nc-t">{item.title}</div>
          <p class="contact-nc-x">{item.text}</p>
        </article>
      ))}
    </div>
  </div></section>
</section>
