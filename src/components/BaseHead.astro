---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import '../styles/ffn-brand.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	image?: string;
	ogTitle?: string;
	ogDescription?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	nofollow?: boolean;
	favicon?: string;
}

const {
	title,
	description,
	image = 'https://firstfornews.net/mockup-assets/ff79aa4a-78e3-4ef4-afe8-72dd2f816909.jpg',
	ogTitle,
	ogDescription,
	canonicalUrl,
	noindex = false,
	nofollow = false,
	favicon = '/favicon.svg',
} = Astro.props;
const HERMES_PRODUCTION_SITE_URL = 'https://firstfornews.net';
function resolveCanonicalUrl(value?: string | URL | null) {
	const raw = value ? value.toString() : Astro.url.pathname;
	const url = new URL(raw, HERMES_PRODUCTION_SITE_URL);
	// Never allow localhost canonicals/social URLs on the live site.
	if (url.hostname === 'localhost' || url.hostname === '127.0.0.1') {
		return new URL(url.pathname, HERMES_PRODUCTION_SITE_URL);
	}
	url.protocol = 'https:';
	url.hostname = 'firstfornews.net';
	url.port = '';
	url.search = '';
	url.hash = '';
	return url;
}
const canonicalURL = canonicalUrl ? resolveCanonicalUrl(canonicalUrl) : resolveCanonicalUrl(Astro.url.pathname);
const socialTitle = ogTitle || title;
const socialDescription = ogDescription || description;
const robots = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow'].join(', ');
const faviconUrl = favicon || '/favicon.svg';
const faviconHref = favicon || '/favicon.svg';
const faviconLower = faviconHref.toLowerCase();
const faviconType = faviconLower.endsWith('.png')
	? 'image/png'
	: faviconLower.endsWith('.ico')
		? 'image/x-icon'
		: faviconLower.endsWith('.jpg') || faviconLower.endsWith('.jpeg')
			? 'image/jpeg'
			: 'image/svg+xml';
---

<script is:inline>
	(function () {
		function isDark() {
			try {
				const stored = localStorage.getItem('theme');
				return stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
			} catch (e) {
				return false;
			}
		}
		function apply() {
			document.documentElement.classList.toggle('dark', isDark());
		}
		apply();
		// ClientRouter swaps in the SSR'd <html> (no .dark) on navigation,
		// so re-apply the persisted theme after each swap, before paint.
		document.addEventListener('astro:after-swap', apply);
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href={faviconUrl} />
<meta name="generator" content={Astro.generator} />

<!-- Tina Cloud rewrites media URLs to assets.tina.io in production; warm the connection. -->
<link rel="preconnect" href="https://assets.tina.io" crossorigin />
<link rel="dns-prefetch" href="https://assets.tina.io" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content={robots} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={socialDescription} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={socialTitle} />
<meta property="twitter:description" content={socialDescription} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- TinaCMS visual editing is wired by the tina() integration in astro.config.mjs; its middleware only touches edit-mode responses, so there's nothing to add here. -->

<ClientRouter />
