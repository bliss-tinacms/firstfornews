---
import { tinaField } from '@tinacms/astro/tina-field';
const { data } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : null;
const hero = block?.hero || {};
const leadership = block?.leadership || {};
const seniorStaff = block?.seniorStaff || {};
const people = [...(leadership.people || []), ...(seniorStaff.people || [])];
const fallbackPeople = [
  { name: 'Michelle Hastings', role: 'Editor-in-Chief', location: 'Baltimore', bio: 'Michelle leads the newsroom from Baltimore. Her career spans more than fifteen years in editorial leadership at national and regional publications, with a background that includes both reporting and editing.' },
  { name: 'Patrick Alvarez', role: 'Managing Editor', location: 'Austin', bio: 'Patrick manages the day-to-day operations of the newsroom. He is responsible for the editorial calendar, story assignments, and the flow of publication across the desks.' },
  { name: 'Angela Simmons', role: 'Business Editor', location: 'Milwaukee', bio: 'Angela runs the business and economy desk. Her reporting career includes more than a decade covering business, finance, and household economics.' },
  { name: 'Kevin Manning', role: 'Standards Editor', location: 'Boise', bio: 'Kevin oversees the publication standards program, handles fact-checking on sensitive material, manages the corrections record, and serves as the stylebook authority.' },
];
const roster = people.length ? people : fallbackPeople;
const demoChips: Record<string, { experience: string; focus: string }> = {
  'Michelle Hastings': { experience: '15+ years', focus: 'Final say on publication' },
  'Patrick Alvarez': { experience: 'Calendar & assignments', focus: 'Desk operations' },
  'Angela Simmons': { experience: '10+ years', focus: 'Business & economy desk' },
  'Kevin Manning': { experience: 'Corrections record', focus: 'Stylebook authority' },
};
function personField(index: number) {
  const leadershipCount = leadership.people?.length || 0;
  if (index < leadershipCount) return leadership.people[index];
  return seniorStaff.people?.[index - leadershipCount];
}
function chipOne(person: any) {
  return person.experience || demoChips[person.name || '']?.experience || 'Editorial desk';
}
function chipTwo(person: any) {
  return person.focus || demoChips[person.name || '']?.focus || person.role;
}
---

<main class="ffn-demo ffn-demo-team">
  <header class="ph"><div class="w"><div class="ph-in">
    <div class="ph-k"><b data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{hero.eyebrow || 'Our Team'}</b></div>
    <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{hero.headline || 'The editors behind the coverage.'}</h1>
    <p class="ph-d" data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{hero.lede || 'Every story on First for News passes through the people below. They decide what runs, hold the corrections record, and answer for what the publication publishes.'}</p>
  </div></div></header>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={leadership ? tinaField(leadership, 'eyebrow') : undefined}>{leadership.eyebrow || 'Editorial leadership'}</span></div>
    <h2 class="h2" data-tina-field={leadership ? tinaField(leadership, 'title') : undefined}>{leadership.title || 'Who runs the newsroom'}</h2>
    <div class="rs">
      {roster.map((person: any, index: number) => (
        <article class="rsi" data-tina-field={personField(index) ? tinaField(personField(index)) : undefined}>
          {person.image ? <img class="rsi-img" src={person.image} alt={person.imageAlt || person.name} /> : <div class="rsi-img demo-img" aria-hidden="true"></div>}
          <div>
            <div class="rsi-hd"><div class="rsi-n">{person.name}</div><div class="rsi-r">{person.role}</div></div>
            <p class="rsi-x">{person.bio}</p>
            <div class="rsi-f"><span>{person.location || 'United States'}</span><span>{chipOne(person)}</span><span>{chipTwo(person)}</span></div>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  {seniorStaff?.title && <section class="cl"><div class="w"><div class="cl-in"><div><h2 data-tina-field={tinaField(seniorStaff, 'title')}>{seniorStaff.title}</h2><p data-tina-field={seniorStaff ? tinaField(seniorStaff, 'eyebrow') : undefined}>{seniorStaff.eyebrow || 'Senior editorial staff'}</p></div><a href="/contact/" class="cl-cta">Contact the newsroom</a></div></div></section>}
</main>
