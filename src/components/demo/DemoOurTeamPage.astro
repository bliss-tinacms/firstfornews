---
import { tinaField } from '@tinacms/astro/tina-field';
const { data } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : null;
const people = block?.leadership?.people || [
  { name: 'Michelle Hastings', role: 'Editor-in-Chief', location: 'Baltimore', bio: 'Michelle leads the newsroom from Baltimore. Her career spans more than fifteen years in editorial leadership at national and regional publications, with a background that includes both reporting and editing.', image: '/Ryan-Marshall.jpg' },
  { name: 'Patrick Alvarez', role: 'Managing Editor', location: 'Austin', bio: 'Patrick manages the day-to-day operations of the newsroom. He is responsible for the editorial calendar, story assignments, and the flow of publication across the desks.' },
  { name: 'Angela Simmons', role: 'Business Editor', location: 'Milwaukee', bio: 'Angela runs the business and economy desk. Her reporting career includes more than a decade covering business, finance, and household economics.' },
  { name: 'Kevin Manning', role: 'Standards Editor', location: 'Boise', bio: 'Kevin oversees the publication standards program, handles fact-checking on sensitive material, manages the corrections record, and serves as the stylebook authority.' },
];
---

<main class="ffn-demo ffn-demo-team">
  <header class="ph"><div class="w"><div class="ph-in">
    <div class="ph-k"><b>Our Team</b></div>
    <h1>The editors behind the coverage.</h1>
    <p class="ph-d">Every story on First for News passes through the people below. They decide what runs, hold the corrections record, and answer for what the publication publishes.</p>
  </div></div></header>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span>Editorial leadership</span></div>
    <h2 class="h2">Who runs the newsroom</h2>
    <div class="rs">
      {people.map((person: any, index: number) => (
        <article class="rsi" data-tina-field={block?.leadership?.people?.[index] ? tinaField(block.leadership.people[index]) : undefined}>
          {person.image ? <img class="rsi-img" src={person.image} alt={person.imageAlt || person.name} /> : <div class="rsi-img demo-img" aria-hidden="true"></div>}
          <div>
            <div class="rsi-hd"><div class="rsi-n">{person.name}</div><div class="rsi-r">{person.role}</div></div>
            <p class="rsi-x">{person.bio}</p>
            <div class="rsi-f"><span>{person.location || 'United States'}</span><span>{person.experience || 'Editorial desk'}</span><span>{person.focus || person.role}</span></div>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <section class="cl"><div class="w"><div class="cl-in"><div><h2>Found an error? Tell an editor.</h2><p>If an article contains a factual error, readers are encouraged to contact us with specific details and supporting information.</p></div><a href="/contact/" class="cl-cta">Contact the newsroom</a></div></div></section>
</main>
