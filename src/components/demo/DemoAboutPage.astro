---
import { tinaField } from '@tinacms/astro/tina-field';

const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const purpose = block?.purpose || {};
const coverage = block?.coverage || {};
const standards = block?.standardsSection || {};
const independence = block?.independence || {};
const newsroom = block?.newsroom || {};
const coverageItems = Array.isArray(coverage?.items) ? coverage.items : [];
const standardItems = Array.isArray(standards?.items) ? standards.items : [];
const contacts = Array.isArray(newsroom?.contacts) ? newsroom.contacts : [];

const t = (value: unknown, fallback: string) => String(value || fallback);
---

<main class="ffn-demo ffn-demo-about">
  <header class="ph"><div class="w"><div class="ph-in">
    <div class="ph-k"><b data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{t(hero.eyebrow, 'About Us')}</b></div>
    <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{t(hero.headline, 'News without the noise.')}</h1>
    <p class="ph-d" data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{t(hero.lede, 'First for News is a general news platform created for readers who want to understand what is happening without wading through unnecessary noise. We cover timely stories, emerging trends, practical topics, and noteworthy developments that affect everyday life.')}</p>
  </div></div></header>

  <section id="connected" class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={purpose ? tinaField(purpose, 'eyebrow') : undefined}>{t(purpose.eyebrow, 'Why we exist')}</span></div>
    <div class="pr2">
      <div class="pr2-l"><h2 class="h2" data-tina-field={purpose ? tinaField(purpose, 'title') : undefined}>{t(purpose.title, 'News that keeps you connected')}</h2></div>
      <div class="pr2-r">
        <p data-tina-field={purpose ? tinaField(purpose, 'paragraphOne') : undefined}>{t(purpose.paragraphOne, 'Our goal is simple: help readers discover relevant information quickly while providing enough context to understand why each story matters.')}</p>
        <p data-tina-field={purpose ? tinaField(purpose, 'paragraphTwo') : undefined}>{t(purpose.paragraphTwo, 'The world moves quickly, and important stories can emerge at any moment. First for News brings together coverage from a broad range of subjects, giving readers one convenient place to explore the issues and ideas shaping the day.')}</p>
        {'paragraphThree' in purpose && <p data-tina-field={tinaField(purpose, 'paragraphThree')}>{purpose.paragraphThree}</p>}
      </div>
    </div>
  </div></section>

  <section id="headlines" class="sc alt"><div class="w">
    <div class="eye"><i></i><span>Written for real people</span></div>
    <div class="pr2">
      <div class="pr2-l"><h2 class="h2">More than headlines</h2></div>
      <div class="pr2-r">
        <p>A headline may capture attention, but it rarely tells the whole story. We believe readers deserve content that offers context, explains key details, and makes complicated topics easier to follow.</p>
        <div class="slab"><i>“</i><p data-tina-field={purpose ? tinaField(purpose, 'pullquote') : undefined}>{t(purpose.pullquote, 'Our aim is to make the news easier to follow without stripping away the facts that matter.')}</p></div>
      </div>
    </div>
  </div></section>

  <section id="approach" class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={standards ? tinaField(standards, 'eyebrow') : undefined}>{t(standards.eyebrow, 'How we work')}</span></div>
    <h2 class="h2" data-tina-field={standards ? tinaField(standards, 'title') : undefined}>{t(standards.title, 'Our editorial approach')}</h2>
    <p class="sec-lead" data-tina-field={standards ? tinaField(standards, 'intro') : undefined}>{t(standards.intro, 'First for News is built around clarity, usefulness, and consistency. We want readers to leave a story better informed than when they arrived.')}</p>
    <div class="cvg">
      {(standardItems.length ? standardItems : [
        { number: '01', title: 'Clarity', text: 'We keep reporting direct, readable, and focused on the facts readers need.' },
        { number: '02', title: 'Context', text: 'We explain why stories matter and how they connect to wider events.' },
        { number: '03', title: 'Usefulness', text: 'We prioritize information readers can understand, share, and act on.' },
      ]).map((item: any) => (
        <article class="cv"><div class="cv-n" data-tina-field={tinaField(item, 'number')}>{item.number}</div><h3 data-tina-field={tinaField(item, 'title')}>{item.title}</h3><p data-tina-field={tinaField(item, 'text')}>{item.text}</p></article>
      ))}
    </div>
  </div></section>

  <section id="coverage" class="sc alt"><div class="w">
    <div class="eye"><i></i><span data-tina-field={coverage ? tinaField(coverage, 'eyebrow') : undefined}>{t(coverage.eyebrow, 'Coverage areas')}</span></div>
    <h2 class="h2" data-tina-field={coverage ? tinaField(coverage, 'title') : undefined}>{t(coverage.title, 'What we cover')}</h2>
    <p class="sec-lead" data-tina-field={coverage ? tinaField(coverage, 'intro') : undefined}>{t(coverage.intro, 'First for News covers a broad range of topics so readers can follow the stories shaping public life, work, culture, health, technology, and the wider world.')}</p>
    <div class="cvg">
      {(coverageItems.length ? coverageItems : [
        { number: '01', title: 'Business', text: 'Companies, markets, industries, and the economic forces reaching households.', link: '/business/' },
        { number: '02', title: 'Technology', text: 'Innovation, digital trends, and the products changing how people live and work.', link: '/technology/' },
        { number: '03', title: 'Health', text: 'Research, medical advances, and discoveries affecting everyday life.', link: '/health/' },
      ]).map((item: any) => (
        <a class="cv" href={item.link || '#'}><div class="cv-n" data-tina-field={tinaField(item, 'number')}>{item.number}</div><h3 data-tina-field={tinaField(item, 'title')}>{item.title}</h3><p data-tina-field={tinaField(item, 'text')}>{item.text}</p></a>
      ))}
    </div>
  </div></section>

  <section id="commitment" class="sc dark"><div class="w">
    <div class="eye"><i></i><span data-tina-field={independence ? tinaField(independence, 'eyebrow') : undefined}>{t(independence.eyebrow, 'Reader commitment')}</span></div>
    <div class="pr2">
      <div class="pr2-l"><h2 class="h2" data-tina-field={independence ? tinaField(independence, 'title') : undefined}>{t(independence.title, 'Our commitment to readers')}</h2></div>
      <div class="pr2-r">
        <p data-tina-field={independence ? tinaField(independence, 'paragraphOne') : undefined}>{t(independence.paragraphOne, 'Readers should know what they are getting from a publication. First for News aims to be timely without becoming careless, broad without becoming scattered, and accessible without oversimplifying important topics.')}</p>
        <p data-tina-field={independence ? tinaField(independence, 'paragraphTwo') : undefined}>{t(independence.paragraphTwo, 'We continue to refine how stories are selected, written, updated, and corrected so the publication remains useful to the people who rely on it.')}</p>
      </div>
    </div>
  </div></section>

  <section id="contact" class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={newsroom ? tinaField(newsroom, 'eyebrow') : undefined}>{t(newsroom.eyebrow, 'Stay connected')}</span></div>
    <h2 class="h2" data-tina-field={newsroom ? tinaField(newsroom, 'title') : undefined}>{t(newsroom.title, 'Stay informed with First for News')}</h2>
    <p class="sec-lead" data-tina-field={newsroom ? tinaField(newsroom, 'intro') : undefined}>{t(newsroom.intro, 'Follow our latest stories, send tips, and contact the newsroom when you have something to share.')}</p>
    {contacts.length > 0 && <div class="cvg">{contacts.map((card: any) => <article class="cv"><h3 data-tina-field={tinaField(card, 'title')}>{card.title}</h3><p data-tina-field={tinaField(card, 'text')}>{card.text}</p>{card.email && <a href={`mailto:${card.email}`} data-tina-field={tinaField(card, 'email')}>{card.email}</a>}</article>)}</div>}
    <a class="btn" href="/contact/">Contact Us →</a>
  </div></section>
</main>
