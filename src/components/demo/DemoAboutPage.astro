---
import { tinaField } from '@tinacms/astro/tina-field';
const { data } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : null;
const hero = block?.hero || {};
const purpose = block?.purpose || {};
const standards = block?.standardsSection || {};
const coverage = block?.coverage || {};
const independence = block?.independence || {};
const newsroom = block?.newsroom || {};
const coverageItems = coverage?.items?.length ? coverage.items : [
  { title: 'Business', text: 'Decisions in business can influence communities, employers, and the cost of everyday life.', link: '/business/' },
  { title: 'Technology', text: 'Advances in technology can affect how people work, communicate, and spend their time.', link: '/technology/' },
  { title: 'Health', text: 'Developments in health and science shape the choices people make about their own care.', link: '/health/' },
  { title: 'Culture & Education', text: 'Changes in culture and education reach classrooms, households, and public conversation.', link: '/lifestyle/' },
  { title: 'Travel & Lifestyle', text: 'Practical topics that inform how people plan, spend, and live day to day.', link: '/lifestyle/' },
  { title: 'Emerging Topics', text: 'Developing conversations and subjects that are only beginning to draw attention.', link: '/blog/' },
];
const principles = standards?.items?.length ? standards.items.map((item: any, index: number) => ({ ...item, number: item.number || String(index + 1).padStart(2, '0') })) : [
  'Put accuracy ahead of speed',
  'Use clear and direct language',
  'Provide meaningful context whenever possible',
  'Rely on credible and relevant sources',
  'Correct material errors when they are identified',
  'Avoid misleading, exaggerated, or sensational presentation',
  'Respect the difference between reporting, analysis, and opinion',
].map((title, index) => ({ number: String(index + 1).padStart(2, '0'), title }));
---

<main class="ffn-demo ffn-demo-about">
  <header class="ph"><div class="w"><div class="ph-in">
    <div class="ph-k"><b data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{hero.eyebrow || 'About Us'}</b></div>
    <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{hero.headline || 'News without the noise.'}</h1>
    <p class="ph-d" data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{hero.lede || 'First for News is a general news platform created for readers who want to understand what is happening without wading through unnecessary noise.'}</p>
  </div></div></header>

  <section id="connected" class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={purpose ? tinaField(purpose, 'eyebrow') : undefined}>{purpose.eyebrow || 'Why we exist'}</span></div>
    <div class="pr2">
      <div class="pr2-l"><h2 class="h2" data-tina-field={purpose ? tinaField(purpose, 'title') : undefined}>{purpose.title || 'News that keeps you connected'}</h2></div>
      <div class="pr2-r">
        <p data-tina-field={purpose ? tinaField(purpose, 'paragraphOne') : undefined}>{purpose.paragraphOne || 'Our goal is simple: help readers discover relevant information quickly while providing enough context to understand why each story matters.'}</p>
        {purpose.pullquote && <div class="slab" data-tina-field={tinaField(purpose, 'pullquote')}><i>“</i><p>{purpose.pullquote}</p></div>}
        <p data-tina-field={purpose ? tinaField(purpose, 'paragraphTwo') : undefined}>{purpose.paragraphTwo || 'The world moves quickly, and important stories can emerge at any moment.'}</p>
      </div>
    </div>
  </div></section>

  <section id="headlines" class="sc alt"><div class="w">
    <div class="eye"><i></i><span>{independence.eyebrow || 'Written for real people'}</span></div>
    <div class="pr2">
      <div class="pr2-l"><h2 class="h2" data-tina-field={independence ? tinaField(independence, 'title') : undefined}>{independence.title || 'More than headlines'}</h2></div>
      <div class="pr2-r">
        <p data-tina-field={independence ? tinaField(independence, 'paragraphOne') : undefined}>{independence.paragraphOne || 'A headline may capture attention, but it rarely tells the whole story.'}</p>
        <div class="slab"><i>“</i><p>Our articles are written for real people, not industry insiders.</p></div>
        <p data-tina-field={independence ? tinaField(independence, 'paragraphTwo') : undefined}>{independence.paragraphTwo || 'We avoid unnecessary jargon and focus on presenting information in a straightforward way.'}</p>
      </div>
    </div>
  </div></section>

  <section id="approach" class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={standards ? tinaField(standards, 'eyebrow') : undefined}>{standards.eyebrow || 'How we work'}</span></div>
    <h2 class="h2" data-tina-field={standards ? tinaField(standards, 'title') : undefined}>{standards.title || 'Our editorial approach'}</h2>
    <div class="pl">
      {principles.map((item: any, index: number) => <div class="pli" data-tina-field={standards?.items?.[index] ? tinaField(standards.items[index]) : undefined}><div class="pli-n">{item.number || String(index + 1).padStart(2, '0')}</div><div class="pli-t">{item.title}</div></div>)}
    </div>
    {standards.intro && <p class="pl-note" data-tina-field={tinaField(standards, 'intro')}>{standards.intro}</p>}
  </div></section>

  <section id="coverage" class="sc alt"><div class="w">
    <div class="eye"><i></i><span data-tina-field={coverage ? tinaField(coverage, 'eyebrow') : undefined}>{coverage.eyebrow || 'Covering a changing world'}</span></div>
    <h2 class="h2" data-tina-field={coverage ? tinaField(coverage, 'title') : undefined}>{coverage.title || 'What we cover'}</h2>
    <div class="cvg">
      {coverageItems.map((item: any, index: number) => <a class="cvi" href={item.link || '/blog/'} data-tina-field={coverage?.items?.[index] ? tinaField(coverage.items[index]) : undefined}><div class="cvi-t">{item.title}</div><p class="cvi-x">{item.text}</p></a>)}
    </div>
    {coverage.intro && <p class="pl-note" data-tina-field={tinaField(coverage, 'intro')}>{coverage.intro}</p>}
  </div></section>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={newsroom ? tinaField(newsroom, 'eyebrow') : undefined}>{newsroom.eyebrow || 'What you can expect'}</span></div>
    <h2 class="h2" data-tina-field={newsroom ? tinaField(newsroom, 'title') : undefined}>{newsroom.title || 'Our commitment to readers'}</h2>
    <div class="cd"><div class="cd-top"><span>Reader Commitment</span><b>Transparency and accountability</b></div><div class="cd-body"><p data-tina-field={newsroom ? tinaField(newsroom, 'intro') : undefined}>{newsroom.intro || 'The trust of our readers matters. We work to create content that is informative, readable, and worth their time.'}</p></div></div>
  </div></section>

  <section class="cl"><div class="w"><div class="cl-in"><div><h2>{newsroom.title || 'Stay informed with First for News'}</h2><p>{newsroom.intro || 'First for News is built for curious readers who want a clearer view of the stories unfolding around them.'}</p></div><a href="/blog/" class="cl-cta">Read the latest</a></div></div></section>
</main>
