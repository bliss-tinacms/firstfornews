---
import { tinaField } from '@tinacms/astro/tina-field';
const { data, config = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : null;
const hero = block?.hero || {};
const form = block?.formSection || {};
const inboxesBlock = block?.inboxes || {};
const requests = block?.requests || {};
const formAction = form.formAction || config?.contactForm?.formspreeEndpoint || 'https://formspree.io/f/xppwzoep';
const subject = form.subject || config?.contactForm?.subject || 'First For News contact form submission';
const inboxes = inboxesBlock?.cards?.length ? inboxesBlock.cards : [
  { title: 'The Newsroom', meta: 'Monitored by the editors', email: 'editorial@firstfornews.net', description: 'Story tips, correction requests, letters to the editor, contributor pitches, and other correspondence intended for the editorial team.' },
  { title: 'General Inquiries', meta: 'U.S. business hours', email: 'info@firstfornews.net', description: 'Advertising and partnership inquiries, technical issues with the site, newsletter and account questions, and general reader correspondence.' },
];
const requestCards = requests?.cards?.length ? requests.cards : [
  { title: 'Corrections', text: 'If you have identified a factual error in a published piece, please send the article URL, the specific error, and the corrected information to the editorial inbox listed above.' },
  { title: 'Letters to the Editor', text: 'Letters written for publication as reader correspondence should be flagged as such in the subject line.' },
  { title: 'DMCA & Legal Notices', text: 'Copyright takedown notices, counter-notifications, and other legal correspondence reach the publication through the editorial address.' },
];
function emailParts(email = '') {
  const [local = '', domain = ''] = String(email).split('@');
  return { local, domain };
}
function safeContactText(text = '') {
  return String(text).replace(/editorial@firstfornews\.net/gi, 'the editorial inbox listed above');
}
---

<main class="ffn-demo ffn-demo-contact">
  <header class="ph"><div class="w"><div class="ph-in">
    <div class="ph-k"><b data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{hero.eyebrow || 'Contact Us'}</b></div>
    <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{hero.headline || 'Get in Touch.'}</h1>
    <p class="ph-d" data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{hero.lede || 'Have a question, a story tip, or something to share? Send us a message and the right person will get back to you.'}</p>
  </div></div></header>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={form ? tinaField(form, 'eyebrow') : undefined}>{form.eyebrow || 'Send a message'}</span></div>
    <h2 class="h2" data-tina-field={form ? tinaField(form, 'title') : undefined}>{form.title || 'Write to the newsroom'}</h2>
    <p class="fm-lead">A person reads every message that arrives here.</p>
    <p class="fm-sub" data-tina-field={form ? tinaField(form, 'description') : undefined}>{form.description || 'Use this form for story tips, corrections, letters to the editor, or general questions.'}</p>
    <form class="fm-f" method="POST" action={formAction} data-tina-field={form ? tinaField(form) : undefined}>
      <input type="hidden" name="_subject" value={subject} />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" />
      <div class="fm-top"><span>Contact Form</span><b>Story tips · Corrections · Letters · General</b></div>
      <div class="fm-b">
        <div class="f3">
          <div class="fr"><label class="fl" for="f-name">Full Name <b>*</b></label><input class="fi" id="f-name" name="full_name" type="text" placeholder="Your full name" required /></div>
          <div class="fr"><label class="fl" for="f-email">Email <b>*</b></label><input class="fi" id="f-email" name="email" type="email" placeholder="you@example.com" required /></div>
          <div class="fr"><label class="fl" for="f-phone">Phone</label><input class="fi" id="f-phone" name="phone" type="tel" placeholder="(000) 000-0000" /></div>
        </div>
        <div class="fr"><label class="fl" for="f-msg">Message <b>*</b></label><textarea class="fi" id="f-msg" name="message" placeholder="What happened, who is involved, and any documents you can share" required></textarea></div>
      </div>
      <div class="fm-foot"><p class="fn" data-tina-field={form ? tinaField(form, 'note') : undefined}>{form.note || 'Fields marked * are required. Read during U.S. business hours. Do not use a work account if your message is sensitive.'}</p><button class="fb" type="submit" data-tina-field={form ? tinaField(form, 'buttonText') : undefined}>{form.buttonText || 'Send to the newsroom'}</button></div>
    </form>
  </div></section>

  <section class="sc alt"><div class="w">
    <div class="eye"><i></i><span data-tina-field={inboxesBlock ? tinaField(inboxesBlock, 'eyebrow') : undefined}>{inboxesBlock.eyebrow || 'Where to write'}</span></div>
    <h2 class="h2" data-tina-field={inboxesBlock ? tinaField(inboxesBlock, 'title') : undefined}>{inboxesBlock.title || 'The two inboxes'}</h2>
    <div class="ad">
      {inboxes.map((card: any, index: number) => (
        <div class="adi" data-tina-field={inboxesBlock?.cards?.[index] ? tinaField(inboxesBlock.cards[index]) : undefined}><div class="adi-top"><span>{card.title}</span><b>{card.meta || card.note || 'U.S. business hours'}</b></div><div class="adi-b"><div class="adi-a" aria-label={`${emailParts(card.email).local} at ${emailParts(card.email).domain}`}>{emailParts(card.email).local}<span aria-hidden="true">@</span>{emailParts(card.email).domain}</div><p class="adi-x">{card.description || card.text}</p>{card.note && <p class="adi-note">{card.note}</p>}</div></div>
      ))}
    </div>
  </div></section>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={requests ? tinaField(requests, 'eyebrow') : undefined}>{requests.eyebrow || 'Specific requests'}</span></div>
    <h2 class="h2" data-tina-field={requests ? tinaField(requests, 'title') : undefined}>{requests.title || 'How to route your message'}</h2>
    {requests.intro && <p class="fm-sub" data-tina-field={tinaField(requests, 'intro')}>{requests.intro}</p>}
    <div class="rt">
      {requestCards.map((card: any, index: number) => <div class="rti" data-tina-field={requests?.cards?.[index] ? tinaField(requests.cards[index]) : undefined}><div class="rti-h">{card.title}</div><p class="rti-x">{safeContactText(card.text)}</p></div>)}
    </div>
  </div></section>

  <section class="cl"><div class="w"><div class="cl-in"><div><h2>Who answers for the coverage</h2><p>Every story passes through the editors listed on our team page. They decide what runs, hold the corrections record, and answer for what the publication publishes.</p></div><a href="/our-team/" class="cl-cta">Meet the team</a></div></div></section>
</main>
