---
import { tinaField } from '@tinacms/astro/tina-field';
const { data, config = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : null;
const formAction = block?.formSection?.formAction || config?.contactForm?.formspreeEndpoint || 'https://formspree.io/f/xppwzoep';
const subject = block?.formSection?.subject || config?.contactForm?.subject || 'First For News contact form submission';
const inboxes = block?.inboxes?.cards || [
  { title: 'The Newsroom', meta: 'Monitored by the editors', email: 'editorial@firstfornews.net', text: 'Story tips, correction requests, letters to the editor, contributor pitches, and other correspondence intended for the editorial team.' },
  { title: 'General Inquiries', meta: 'U.S. business hours', email: 'info@firstfornews.net', text: 'Advertising and partnership inquiries, technical issues with the site, newsletter and account questions, and general reader correspondence.' },
];
---

<main class="ffn-demo ffn-demo-contact">
  <header class="ph"><div class="w"><div class="ph-in">
    <div class="ph-k"><b>Contact Us</b></div>
    <h1>Get in Touch.</h1>
    <p class="ph-d">Have a question, a story tip, or something to share? Send us a message and the right person will get back to you.</p>
  </div></div></header>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span>Send a message</span></div>
    <h2 class="h2">Write to the newsroom</h2>
    <p class="fm-lead">A person reads every message that arrives here.</p>
    <p class="fm-sub">Use this form for story tips, corrections, letters to the editor, or general questions. If your message concerns a sensitive matter, state at the top whether you are on the record, on background, or off the record — before you tell us anything.</p>
    <form class="fm-f" method="POST" action={formAction} data-tina-field={block?.formSection ? tinaField(block.formSection) : undefined}>
      <input type="hidden" name="_subject" value={subject} />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" />
      <div class="fm-top"><span>Contact Form</span><b>Story tips · Corrections · Letters · General</b></div>
      <div class="fm-b">
        <div class="f3">
          <div class="fr"><label class="fl" for="f-name">Full Name <b>*</b></label><input class="fi" id="f-name" name="full_name" type="text" placeholder="Your full name" required /></div>
          <div class="fr"><label class="fl" for="f-email">Email <b>*</b></label><input class="fi" id="f-email" name="email" type="email" placeholder="you@example.com" required /></div>
          <div class="fr"><label class="fl" for="f-phone">Phone</label><input class="fi" id="f-phone" name="phone" type="tel" placeholder="(000) 000-0000" /></div>
        </div>
        <div class="fr"><label class="fl" for="f-msg">Message <b>*</b></label><textarea class="fi" id="f-msg" name="message" placeholder="What happened, who is involved, and any documents you can share" required></textarea></div>
      </div>
      <div class="fm-foot"><p class="fn">Fields marked <b>*</b> are required. Read during U.S. business hours. Do not use a work account if your message is sensitive.</p><button class="fb" type="submit">Send to the newsroom</button></div>
    </form>
  </div></section>

  <section class="sc alt"><div class="w">
    <div class="eye"><i></i><span>Where to write</span></div>
    <h2 class="h2">The two inboxes</h2>
    <div class="ad">
      {inboxes.map((card: any) => (
        <div class="adi"><div class="adi-top"><span>{card.title}</span><b>{card.meta}</b></div><div class="adi-b"><a href={`mailto:${card.email}`} class="adi-a">{card.email}</a><p class="adi-x">{card.text}</p><p class="adi-note">If your tip concerns a sensitive matter, please indicate at the top of your message whether you want to speak on the record, on background, or off the record.</p></div></div>
      ))}
    </div>
  </div></section>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span>Specific requests</span></div>
    <h2 class="h2">How to route your message</h2>
    <div class="rt">
      <div class="rti"><div class="rti-h">Corrections</div><p class="rti-x">If you have identified a factual error in a published piece, please send the article URL, the specific error, and the corrected information to editorial@firstfornews.net.</p></div>
      <div class="rti"><div class="rti-h">Letters to the Editor</div><p class="rti-x">Letters written for publication as reader correspondence should be flagged as such in the subject line. Published letters carry the writer's name and city.</p></div>
      <div class="rti"><div class="rti-h">DMCA &amp; Legal Notices</div><p class="rti-x">Copyright takedown notices, counter-notifications, and other legal correspondence reach the publication through the editorial address.</p></div>
    </div>
  </div></section>

  <section class="cl"><div class="w"><div class="cl-in"><div><h2>Who answers for the coverage</h2><p>Every story passes through the editors listed on our team page. They decide what runs, hold the corrections record, and answer for what the publication publishes.</p></div><a href="/our-team/" class="cl-cta">Meet the team</a></div></div></section>
</main>
