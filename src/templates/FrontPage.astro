---
import { getBlogPermalink } from '../lib/permalinks';
import type { CmsBlog, CmsConfig } from '../lib/data';

type Post = CmsBlog;

interface Props {
	posts: Post[];
	config?: CmsConfig | null;
	data?: any;
}

const { posts, config, data } = Astro.props;
const homepageBlocks = Array.isArray(data?.blocks) ? data.blocks : [];
const isHomepageTemplateBlock = (block: any) =>
	block?._template === 'homepageTemplate' || block?.__typename === 'PageBlocksHomepageTemplate';
const homepageBlock = homepageBlocks.find(isHomepageTemplateBlock) ?? null;
const homepage = homepageBlock ?? data?.homepage ?? {};
const seo = config?.seo ?? null;
const siteTitle = seo?.title || 'Harbor Post';

function value<T>(input: T | null | undefined, fallback: T): T {
	return input === null || input === undefined || input === '' ? fallback : input;
}

function list<T>(input: T[] | null | undefined, fallback: T[]): T[] {
	return Array.isArray(input) && input.length ? input : fallback;
}

function getReferenceLabel(reference: unknown) {
	if (!reference) return null;
	if (typeof reference === 'string') {
		return reference.split('/').pop()?.replace(/.(json|mdx?)$/, '').replace(/-/g, ' ') ?? null;
	}
	if (typeof reference === 'object' && reference) {
		const record = reference as { title?: string | null; name?: string | null };
		return record.title || record.name || null;
	}
	return null;
}

function getPostUrl(post: Post) {
	return getBlogPermalink(post) + '/';
}

function getPostTitle(post: Post) {
	return post.title || 'Untitled story';
}

function getPostDescription(post: Post) {
	return post.description || 'Read the latest reporting from the newsroom.';
}

const featured = posts[0] ?? null;
const latest = posts.slice(1, 5);
const fallbackImage = '/blog-placeholder-1.jpg';

const hero = homepage.hero ?? {};
const why = homepage.why ?? {};
const newsroom = homepage.newsroom ?? {};
const wireFeature = homepage.wireFeature ?? {};
const coverage = homepage.coverage ?? {};
const contact = homepage.contact ?? {};

const standards = list(why.standards, [
	{ label: 'Accuracy', title: 'Verifiable and Corrected', text: 'Every factual claim should be verifiable, and errors found after publication are corrected openly on the record.' },
	{ label: 'Fairness', title: 'A Right of Response', text: 'Subjects of substantive allegations get a meaningful chance to respond before publication.' },
	{ label: 'Independence', title: 'Separate From Commercial', text: 'Coverage decisions are made on the merits of the story, not by advertisers or sponsors.' },
	{ label: 'Transparency', title: 'Clearly Labeled', text: 'News, analysis, opinion, and sponsored content are labeled clearly and kept visibly distinct.' },
]);

const submitPrompts = list(newsroom.prompts, [
	{ title: 'Submit Your Story', text: 'Got breaking news, a company announcement, local update, event, or noteworthy story?' },
	{ title: 'Get Featured', text: 'Send us the details and supporting information for editorial consideration.' },
	{ title: 'Reach More Readers', text: 'Share your news with audiences looking for timely stories and updates.' },
]);

const coverageTopics = list(coverage.topics, [
	{ number: '01', title: 'National News & Politics', text: 'Major national developments, political news, public affairs, and stories shaping the conversation across the country.' },
	{ number: '02', title: 'Business & Economy', text: 'Business developments, economic trends, companies, markets, industries, and the forces affecting consumers and communities.' },
	{ number: '03', title: 'Technology', text: 'Technology news, AI developments, digital trends, innovation, startups, and the products changing how people live and work.' },
	{ number: '04', title: 'Health & Science', text: 'Health developments, scientific research, medical advances, wellness topics, and discoveries affecting everyday life.' },
	{ number: '05', title: 'Lifestyle & Culture', text: 'Travel, entertainment, food, culture, trends, and stories reflecting how people live, work, and spend their time.' },
	{ number: '06', title: 'Features & Everyday Life', text: 'General-interest stories, practical reporting, community topics, and useful features that put current events into perspective.' },
]);

const contactCards = list(contact.cards, [
	{ title: 'News Submissions', email: 'submit@firstfornews.net', text: 'Send the announcement, the issuing organization, and when it should publish.', accent: true },
	{ title: 'Corrections', email: 'corrections@firstfornews.net', text: 'Include the article link, the specific error, and the correct information.', accent: false },
	{ title: 'Partnerships & Office', email: 'info@firstfornews.net', text: 'Advertising, syndication partners, technical issues, and general inquiries.', accent: false },
]);
---

<main class="homepage-template">
	<section class="homepage-hero homepage-hero--demo" aria-labelledby="homepage-hero-title">
		<div class="homepage-hero__media">
			<img src={value(hero.image, '/mockup-assets/ff79aa4a-78e3-4ef4-afe8-72dd2f816909.jpg')} alt={value(hero.imageAlt, 'Newsroom editors reviewing national stories')} />
		</div>
		<div class="site-wrap">
			<div class="homepage-hero__content">
				<p class="homepage-hero__eyebrow">{value(hero.eyebrow, 'More Than the Headline')}</p>
				<h1 id="homepage-hero-title">{value(hero.title, 'Reporting That Puts the Story in Perspective')}</h1>
				<p>{value(hero.description, 'First For News brings clarity and context to national developments, business, technology, health, culture, and the issues closest to everyday life.')}</p>
				<a href="/contact" class="homepage-hero__button">{value(hero.buttonText, 'Submit Your News')}</a>
			</div>
		</div>
	</section>

	<section class="editorial-standards" aria-labelledby="editorial-standards-title">
		<div class="site-wrap editorial-standards__inner">
			<div class="editorial-standards__copy">
				<p class="section-eyebrow">{value(why.eyebrow, 'Why First For News')}</p>
				<h2 id="editorial-standards-title">{value(why.title, 'Reporting built for the general reader.')}</h2>
				<p>{value(why.paragraphOne, 'First For News is an independent digital news publication serving American readers, covering the events, decisions, and developments that shape daily life in the United States.')}</p>
				<p>{value(why.paragraphTwo, 'The aim is coverage that is neither watered down for the sake of speed nor bloated for the sake of length, written without unnecessary jargon, and held to a plainly stated set of editorial standards.')}</p>
			</div>
			<div class="editorial-standards__grid">
				{standards.map((item) => (
					<article class="standard-card">
						<span>{item.label}</span>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="newsroom-board" aria-labelledby="newsroom-board-title">
		<div class="site-wrap newsroom-board__inner">
			<div class="latest-news-list">
				<div class="section-heading section-heading--compact">
					<span id="newsroom-board-title">{value(newsroom.heading, 'Latest from the Newsroom')}</span>
					<span>{value(newsroom.subheading, 'Updated this morning')}</span>
				</div>
				{latest.map((post) => (
					<a href={getPostUrl(post)} class="latest-news-item">
						<span class="latest-news-item__category">{getReferenceLabel(post.category) || 'News'}</span>
						<span class="latest-news-item__body">
							<strong>{getPostTitle(post)}</strong>
							<em>{getPostDescription(post)}</em>
						</span>
					</a>
				))}
			</div>
			<aside class="submit-news-panel" aria-labelledby="submit-news-panel-title">
				<h2 id="submit-news-panel-title">{value(newsroom.submitHeading, 'Have News to Share?')}</h2>
				{submitPrompts.map((item) => (
					<a href={value(newsroom.submitButtonLink, '/contact')} class="submit-news-panel__item">
						<strong>{item.title}</strong>
						<span>{item.text}</span>
					</a>
				))}
				<a href={value(newsroom.submitButtonLink, '/contact')} class="submit-news-panel__button">{value(newsroom.submitButtonText, 'Submit Your News')}</a>
			</aside>
		</div>
	</section>

	<section class="wire-feature wire-feature--demo" aria-label="Featured editorial quote">
		<div class="wire-feature__image">
			<img src={value(wireFeature.image, '/mockup-assets/4f124e1e-a72e-4a01-956d-84f01ca3d6d1.jpg')} alt={value(wireFeature.imageAlt, 'Editor writing notes beside a laptop')} />
		</div>
		<div class="wire-feature__content">
			<p class="section-eyebrow">{value(wireFeature.eyebrow, 'From the Wire')}</p>
			<blockquote>{value(wireFeature.quote, 'Every story starts with the same standard: get the facts right, make them verifiable, and correct the record openly when we fall short.')}</blockquote>
			<div class="wire-feature__byline">
				<strong>{value(wireFeature.author, 'Amanda Wright')}</strong>
				<span>{value(wireFeature.byline, 'Editor-in-Chief, First For News Â· Minneapolis Â· Fifteen years in editorial leadership')}</span>
			</div>
		</div>
	</section>

	<section class="coverage-topics what-we-cover-static" aria-labelledby="coverage-topics-title">
		<div class="site-wrap what-we-cover-static__wrap">
			<div class="what-we-cover-static__header">
				<h2 id="coverage-topics-title">{value(coverage.title, 'What we cover')}</h2>
				<p>{value(coverage.description, 'First For News reports on the major stories shaping the country while also delivering practical, useful coverage that helps readers understand what is happening in their communities and everyday lives.')}</p>
			</div>

			<div class="what-we-cover-static__grid">
				{coverageTopics.map((item) => (
					<article class="what-we-cover-static__card">
						<span>{item.number}</span>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="contact-section get-in-touch-static" id="contact-form" aria-labelledby="contact-section-title">
		<div class="site-wrap get-in-touch-static__wrap">
			<div class="get-in-touch-static__header">
				<p class="section-eyebrow">{value(contact.eyebrow, 'Get In Touch')}</p>
				<h2 id="contact-section-title">{value(contact.title, 'Have news? Send it over.')}</h2>
				<p>{value(contact.description, 'Submissions, corrections, and partnership inquiries all reach a person on our editorial team.')}</p>
				<p>{value(contact.note, 'Include the supporting details up front and review moves faster.')}</p>
			</div>

			<div class="get-in-touch-static__cards">
				{contactCards.map((item, index) => (
					<article class:list={['get-in-touch-static__card', item.accent && 'get-in-touch-static__card--accent']}>
						<span class="get-in-touch-static__icon" aria-hidden="true">
							{index === 0 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>}
							{index === 1 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>}
							{index >= 2 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>}
						</span>
						<h3>{item.title}</h3>
						<a href={'mailto:' + item.email}>{item.email}</a>
						<p>{item.text}</p>
					</article>
				))}
			</div>
		</div>
	</section>
</main>
