---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig } from '../lib/data';

type NavItem = {
  label?: string | null;
  href?: string | null;
};

type NavigationDocument = {
  title?: string | null;
  items?: (NavItem | null)[] | null;
};

interface Props {
  config?: CmsConfig | null;
  navigation?: NavigationDocument | null;
}

const { config, navigation } = Astro.props;

const currentYear = new Date().getFullYear();
const footerMenuItems = ((navigation?.items ?? []) as NavItem[]).filter((item) => item && item.label && item.href);
const seo = config?.seo ?? null;
const siteTitle = seo?.title || 'Splash Newswire';
const footerLogo = seo?.footerLogo || seo?.logo || '';
---

<footer class="foot">
  <div class="w">
    <div class="foot-hero">
      <div class="fh-l">
        {footerLogo ? (
          <img
            class="fh-logo"
            src={footerLogo}
            alt={siteTitle}
            data-tina-field={seo ? tinaField(seo, "footerLogo") : undefined}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="fh-wordmark" aria-label={siteTitle}>
            <span class="fh-mark" aria-hidden="true"></span>
            <span>{siteTitle}</span>
          </div>
        )}
        <p class="fh-p">Share news that matters. From company announcements and community developments to events and noteworthy updates, your story can start here.</p>
      </div>
      <div class="fh-r">
        <div class="fh-eye">Have news to share?</div>
        <p class="fh-h">Put Your Story on Our Radar</p>
        <p class="fh-x">Send your announcement, story tip, or noteworthy update to the Splash Newswire editorial team for review and editorial consideration.</p>
        <a href="/contact" class="fh-cta">Submit your news</a>
      </div>
    </div>
  </div>

  <div class="w">
    <div class="foot-btm">
      <p>&copy; {currentYear} Splash Newswire. Your news, everywhere it matters.</p>
      <nav class="foot-legal" aria-label={navigation?.title || 'Footer menu'}>
        {footerMenuItems.map((item) => (
          <a href={item.href || '#'} data-tina-field={tinaField(item, "label")}>{item.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
