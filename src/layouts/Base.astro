---
import BaseHead from '../components/BaseHead.astro';
import Header from '../templates/Header.astro';
import Footer from '../templates/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getConfig, getHeaderNavigation, getFooterNavigation } from '../lib/data';
import { islands } from '../lib/islands';

interface Props {
	title: string;
	description: string;
	image?: string;
	ogTitle?: string;
	ogDescription?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	nofollow?: boolean;
}

const { title, description, image, ogTitle, ogDescription, canonicalUrl, noindex, nofollow } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
const headerNavigation = (await getHeaderNavigation()).data?.navigation ?? null;
const footerNavigation = (await getFooterNavigation()).data?.navigation ?? null;
const headerCode = config?.codeInjection?.headerCode?.trim() || '';
const footerCode = config?.codeInjection?.footerCode?.trim() || '';
const favicon = config?.seo?.favicon || config?.favicon || '/favicon.svg';
const defaultSocialImage = config?.seo?.defaultSocialImage || undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image || defaultSocialImage}
			ogTitle={ogTitle}
			ogDescription={ogDescription}
			canonicalUrl={canonicalUrl}

			noindex={noindex}
			nofollow={nofollow}
		
			favicon={favicon}
		/>
		{headerCode && <Fragment set:html={headerCode} />}
	</head>
	<body>
		<div class="tr"></div>
		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} navigation={headerNavigation} />
		</TinaIsland>
		<slot />
		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} navigation={footerNavigation} />
		</TinaIsland>
		{footerCode && <Fragment set:html={footerCode} />}
	</body>
</html>
