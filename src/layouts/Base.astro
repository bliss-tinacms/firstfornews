---
import BaseHead from '../components/BaseHead.astro';
import Header from '../templates/Header.astro';
import Footer from '../templates/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getConfig, getHeaderNavigation, getFooterNavigation } from '../lib/data';
import { islands } from '../lib/islands';

interface Props {
	title: string;
	description: string;
	image?: string;
	ogTitle?: string;
	ogDescription?: string;
	canonicalUrl?: string;
	noindex?: boolean;
	nofollow?: boolean;
}

const { title, description, image, ogTitle, ogDescription, canonicalUrl, noindex, nofollow } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
const headerNavigation = (await getHeaderNavigation()).data?.navigation ?? null;
const footerNavigation = (await getFooterNavigation()).data?.navigation ?? null;
const headerCode = config?.codeInjection?.headerCode?.trim() || '';
const footerCode = config?.codeInjection?.footerCode?.trim() || '';
const favicon = config?.seo?.favicon || config?.favicon || '/favicon.svg';
const defaultSocialImage = config?.seo?.defaultSocialImage || undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image || defaultSocialImage}
			ogTitle={ogTitle}
			ogDescription={ogDescription}
			canonicalUrl={canonicalUrl}

			noindex={noindex}
			nofollow={nofollow}

			favicon={favicon}
		/>
		{headerCode && <Fragment set:html={headerCode} />}
	</head>
	<body>
		<div class="tr"></div>
		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} navigation={headerNavigation} />
		</TinaIsland>
		<slot />
		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} navigation={footerNavigation} />
		</TinaIsland>
		<script is:inline>
			// @tinacms/bridge can send its one-time primary-form selection before
			// Tina's admin has registered the article form. Repeat the same safe
			// selection message briefly so multi-island pages open the document
			// editor instead of whichever global form registered first.
			if (window.self !== window.top) {
				let attempts = 0;
				const selectPrimaryForm = () => {
					attempts += 1;
					const island = document.querySelector('[data-tina-island-primary]');
					const form = document.querySelector('[data-tina-primary][data-tina-form]')
						|| (island?.matches('[data-tina-form]')
							? island
							: island?.querySelector('[data-tina-form]'));
					try {
						const payload = JSON.parse(form?.getAttribute('data-tina-form') || '{}');
						if (payload.id) {
							window.parent.postMessage(
								{ type: 'user-select-form', formId: payload.id },
								window.location.origin,
							);
						}
					} catch (_error) {
						// The bridge will retry while the island payload is being mounted.
					}
					if (attempts >= 40) clearInterval(timer);
				};
				const timer = setInterval(selectPrimaryForm, 250);
				selectPrimaryForm();
			}
		</script>
		{footerCode && <Fragment set:html={footerCode} />}
	</body>
</html>
